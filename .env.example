NUXT_OAUTH_GITHUB_CLIENT_ID=""
NUXT_OAUTH_GITHUB_CLIENT_SECRET=""
NUXT_SESSION_PASSWORD="change-me-with-a-long-random-secret"

# Required server-side education API configuration
EDUCATION_API_BASE_URL="https://your-education-api.example.com"
EDUCATION_API_USERNAME="<set-secure-username>"
EDUCATION_API_PASSWORD="<set-secure-password>"

# Required server-side ecommerce credentials
ECOMMERCE_ADMIN_EMAIL="admin@example.com"
ECOMMERCE_ADMIN_PASSWORD="<set-secure-password>"
ECOMMERCE_SHOP_EMAIL="shop@example.com"
ECOMMERCE_SHOP_PASSWORD="<set-secure-password>"

MERCURE_URL="https://mercure.example.com/.well-known/mercure"
MERCURE_PUBLIC_URL="https://mercure.example.com/.well-known/mercure"
MERCURE_JWT_SECRET="<set-mercure-jwt-secret>"

# Configure the upstream ecommerce API origin if it differs from the default
NUXT_ECOMMERCE_API_BASE_URL="https://ecommerce.example.com/api/v2"
NUXT_PUBLIC_ECOMMERCE_ORIGIN="https://ecommerce.example.com"

# Client-side public settings (safe to expose)
NUXT_PUBLIC_EDUCATION_API_BASE_URL=""
NUXT_PUBLIC_MESSENGER_API_BASE=""
NUXT_PUBLIC_MESSENGER_HUB_URL=""
NUXT_PUBLIC_MESSENGER_NOTIFICATION_TOPIC=""
NUXT_PUBLIC_MESSENGER_NOTIFICATION_RECONNECT_DELAY=""
NUXT_PUBLIC_MESSENGER_NOTIFICATION_WITH_CREDENTIALS=""

# The {userId} placeholder will be replaced with the authenticated user id and
# {conversationId} will expand to each of the user's conversations.
NUXT_PUBLIC_MESSENGER_SUBSCRIPTION_TOPICS="/messages/{userId}/{conversationId}"
NUXT_PUBLIC_MESSENGER_SUBSCRIPTION_HUB_URL=""
NUXT_PUBLIC_MESSENGER_SUBSCRIPTION_TOKEN=""
NUXT_PUBLIC_MESSENGER_SUBSCRIPTION_WITH_CREDENTIALS=""
NUXT_PUBLIC_MESSENGER_SUBSCRIPTION_RETRY=""
